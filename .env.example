# ---------------------------------------------------------------------------
# SynseHub — variaveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione segredos.
# ---------------------------------------------------------------------------

# URL publica da aplicacao (usada em links de cobranca, webhooks e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente logico do Synse: development | staging | production
NEXT_PUBLIC_SYNSE_ENV=development

# ---------------------------------------------------------------------------
# Supabase
# Sem estas variaveis a aplicacao inicia em DEMO MODE (dados em memoria).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico — SOMENTE server-side. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Synse Pay — provedor de pagamentos
# Valores aceitos: mock
#
# Valores aceitos: mock | mercadopago
#
# O Mercado Pago atende **so a assinatura do Synse+** — dinheiro que entra na
# conta do Synse. A mensalidade da academia precisa de subconta e split, que
# ele faz por outro caminho (OAuth + KYC 6) e ainda nao foi integrado: com
# mercadopago ligado, a tela de cobranca da academia continua dizendo que a
# cobranca esta indisponivel, em vez de oferecer um botao que falha no clique.
#
# Um nome desconhecido aqui nao derruba a aplicacao — ela cai no simulado, e
# /api/health?deep=1 mostra os dois lados, o pedido e o em uso. O mesmo vale
# para mercadopago sem MERCADOPAGO_ACCESS_TOKEN.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

# ---------------------------------------------------------------------------
# Mercado Pago — assinatura do Synse+.
#
# ACCESS_TOKEN: credencial de producao da sua aplicacao, em Suas integracoes.
# Assina as chamadas a API. Sem ela a fabrica cai no simulado de proposito.
#
# WEBHOOK_SECRET: a "chave secreta" do webhook, no mesmo painel. Serve so para
# conferir a assinatura do que chega, e nunca e enviada a lugar nenhum.
#
# As duas sao segredo: vao em .env.local e na Vercel como Sensitive, nunca no
# codigo. Token sem segredo de webhook e o pior dos estados — a pessoa paga e
# a confirmacao nunca chega, porque todo aviso e recusado. A sonda separa os
# dois casos.
#
# URL do webhook a cadastrar no painel do Mercado Pago, evento "Assinaturas":
#   https://SEU-DOMINIO/api/webhooks/payments/mercadopago
# ---------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Carteira da plataforma no provedor — recebe a comissao via split.
# Sem provedor real ela nao e lida por nada hoje. Fica documentada porque a
# regra continua valendo para o proximo: a cobranca sai pela subconta da
# academia, o split desvia o percentual para ca, e a ausencia da carteira
# derruba a emissao em producao em vez de mandar a cobranca inteira para a
# academia sem comissao e sem erro na tela.
# ---------------------------------------------------------------------------
SYNSE_PLATFORM_WALLET_ID=

# ---------------------------------------------------------------------------
# Taxas padrao da plataforma (podem ser sobrescritas por organizacao no banco)
# ---------------------------------------------------------------------------
SYNSE_DEFAULT_PLATFORM_FEE_PERCENTAGE=2
SYNSE_DEFAULT_PLATFORM_FIXED_FEE=0

# E-mail do proprietário no seed de demonstração. O link de acesso só chega
# num endereço que existe de verdade — sem isso o seed cria contas fictícias
# que ninguém consegue usar para entrar.
SEED_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Mapa do SynseRun
# ---------------------------------------------------------------------------
# Em branco, o mapa usa os azulejos publicos do OpenStreetMap: sem chave e sem
# custo, mas a politica de uso deles nao cobre aplicacao comercial de volume.
# Antes de escalar, contrate um fornecedor (MapTiler, Mapbox, Thunderforest ou
# um servidor proprio) e aponte estas tres variaveis para ele. A atribuicao e
# obrigatoria em praticamente todos, e aparece no canto do mapa.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=
# "dark" ou "light" quando o fornecedor ja entrega o mapa desenhado; em branco
# para azulejo cru do OpenStreetMap, que o app repinta com filtro. Declarar
# errado nao quebra o app: filtrar um mapa ja escuro o inverte de novo, e o
# resultado e um mapa branco de aparencia quebrada.
NEXT_PUBLIC_MAP_TILE_STYLE=

# ---------------------------------------------------------------------------
# Identificacao legal (Termos de Uso e Politica de Privacidade)
# ---------------------------------------------------------------------------
# Em branco, as paginas dizem que a identificacao do controlador esta em
# andamento e mostram so o contato. Preencher antes de cobrar de alguem.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT=privacidade@synse.com.br

# ---------------------------------------------------------------------------
# Rotina diaria de cobranca
# ---------------------------------------------------------------------------
# A Vercel envia este valor em "Authorization: Bearer" ao chamar
# /api/cron/billing. Sem ele configurado o endereco recusa tudo — nunca aceita
# por omissao. Gere um valor longo e aleatorio e cadastre como Sensitive.
CRON_SECRET=

# ---------------------------------------------------------------------------
# App Android — App Links
# ---------------------------------------------------------------------------
# SHA-256 do certificado que assina o APK que CHEGA AO APARELHO. Com o App
# Signing da Play Console ligado (o padrao hoje), a digital certa e a que ela
# mostra em "Integridade do app", e nao a da sua chave de upload. Trocar as
# duas e o erro mais comum, e o sintoma e silencioso: o link continua abrindo
# no navegador.
#
# Aceita mais de uma separada por virgula — em geral sao duas, producao e
# teste interno. Em branco, /.well-known/assetlinks.json responde 404, que
# deixa a verificacao pendente em vez de o dominio negar o app.
ANDROID_CERT_FINGERPRINTS=
# So mude se o applicationId do android/app/build.gradle mudar junto.
NEXT_PUBLIC_ANDROID_APP_ID=br.com.synse.app

# ---------------------------------------------------------------------------
# Push web — aviso que chega com o app fechado
#
# Gere o par com: npx web-push generate-vapid-keys
# A publica vai para o cliente; a privada assina o envio e nunca sai do
# servidor. Sem as tres, o recurso simplesmente nao aparece na tela — em vez de
# oferecer um botao que falha no clique.
#
# VAPID_SUBJECT e um contato para o servico de entrega reclamar, no formato
# mailto: ou https:. Nao e opcional pelo padrao.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@synse.com.br
