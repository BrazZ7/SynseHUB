<?xml version="1.0" encoding="utf-8"?>
<!--
  As permissões de leitura do Health Connect.

  Cada tipo tem a sua, e pedir uma que o app não usa é reprovação na Play
  Console: a política de dados de saúde exige que cada permissão declarada
  apareça no fluxo. Esta lista é exatamente o que `SynseHealthPlugin.permissoes`
  pede — se uma sair de lá, sai daqui também.

  Falta ainda, no manifesto do **app** (não deste módulo), a activity que
  responde a `ACTION_SHOW_PERMISSIONS_RATIONALE`. Sem ela a Play Console
  reprova: é a tela que explica por que o app quer os dados.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.health.READ_WEIGHT" />
  <uses-permission android:name="android.permission.health.READ_BODY_FAT" />
  <uses-permission android:name="android.permission.health.READ_LEAN_BODY_MASS" />
  <uses-permission android:name="android.permission.health.READ_BONE_MASS" />
  <uses-permission android:name="android.permission.health.READ_BODY_WATER_MASS" />
  <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" />

  <queries>
    <!-- Sem isto, `getSdkStatus` não enxerga o app do Health Connect no Android 11+. -->
    <package android:name="com.google.android.apps.healthdata" />
  </queries>
</manifest>
