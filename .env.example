# ---------------------------------------------------------------------------
# SynseHub — variaveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione segredos.
# ---------------------------------------------------------------------------

# URL publica da aplicacao (usada em links de cobranca, webhooks e e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente logico do Synse: development | staging | production
NEXT_PUBLIC_SYNSE_ENV=development

# ---------------------------------------------------------------------------
# Supabase
# Sem estas variaveis a aplicacao inicia em DEMO MODE (dados em memoria).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico — SOMENTE server-side. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Synse Pay — provedor de pagamentos
# Valores aceitos: mock | asaas
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock

ASAAS_API_KEY=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token compartilhado usado para autenticar o webhook do Asaas.
# Sem ele o webhook rejeita TUDO — nunca aceita por omissao.
ASAAS_WEBHOOK_TOKEN=

# Carteira usada no split durante `npm run test:asaas`. Opcional: sem ela o
# teste roda e avisa que o split nao foi verificado.
ASAAS_TEST_WALLET_ID=

# ---------------------------------------------------------------------------
# Carteira da plataforma no provedor — recebe a comissao via split.
# A cobranca sai pela subconta da academia; o split desvia o percentual para
# ca. Sem esta variavel a cobranca sairia inteira para a academia e a comissao
# simplesmente nao existiria, sem erro nenhum na tela — por isso a ausencia
# derruba a emissao em vez de passar batido.
# ---------------------------------------------------------------------------
SYNSE_PLATFORM_WALLET_ID=

# ---------------------------------------------------------------------------
# Taxas padrao da plataforma (podem ser sobrescritas por organizacao no banco)
# ---------------------------------------------------------------------------
SYNSE_DEFAULT_PLATFORM_FEE_PERCENTAGE=2
SYNSE_DEFAULT_PLATFORM_FIXED_FEE=0

# E-mail do proprietário no seed de demonstração. O link de acesso só chega
# num endereço que existe de verdade — sem isso o seed cria contas fictícias
# que ninguém consegue usar para entrar.
SEED_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Mapa do SynseRun
# ---------------------------------------------------------------------------
# Em branco, o mapa usa os azulejos publicos do OpenStreetMap: sem chave e sem
# custo, mas a politica de uso deles nao cobre aplicacao comercial de volume.
# Antes de escalar, contrate um fornecedor (MapTiler, Mapbox, Thunderforest ou
# um servidor proprio) e aponte estas tres variaveis para ele. A atribuicao e
# obrigatoria em praticamente todos, e aparece no canto do mapa.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=

# ---------------------------------------------------------------------------
# Identificacao legal (Termos de Uso e Politica de Privacidade)
# ---------------------------------------------------------------------------
# Em branco, as paginas dizem que a identificacao do controlador esta em
# andamento e mostram so o contato. Preencher antes de cobrar de alguem.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_CONTACT=privacidade@synse.com.br

# ---------------------------------------------------------------------------
# Rotina diaria de cobranca
# ---------------------------------------------------------------------------
# A Vercel envia este valor em "Authorization: Bearer" ao chamar
# /api/cron/billing. Sem ele configurado o endereco recusa tudo — nunca aceita
# por omissao. Gere um valor longo e aleatorio e cadastre como Sensitive.
CRON_SECRET=
